# Copy to .env and fill in real values. Never commit .env.

# API
PORT=8080
RELAY_DEMO_TOKEN=relay-demo-token

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=relay
DB_TIMEOUT_MS=5000

# Mock world (scripts/mock_world.py)
MOCK_WORLD_URL=http://localhost:9210
ALLOWED_HTTP_HOSTS=localhost:9210
HTTP_TIMEOUT_MS=5000

# AI provider: openai (Groq, OpenAI-compatible) | heuristic (offline keyword rules)
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=<your-groq-api-key>
AI_TIMEOUT_MS=20000

# Engine / worker
MAX_ATTEMPTS=4
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=15000
LEASE_MS=30000
POLL_MS=500
MAX_CLAIMS=10
# WORKER_ID defaults to worker-<pid>
